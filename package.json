{
	"name": "lisztnup",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "pnpm sync:tracklist && vite build && pnpm minify-json",
		"sync:tracklist": "tsx scripts/sync-tracklist-md.ts",
		"minify-json": "node -e \"const fs=require('fs');const data=JSON.parse(fs.readFileSync('.svelte-kit/cloudflare/lisztnup.json','utf8'));fs.writeFileSync('.svelte-kit/cloudflare/lisztnup.json',JSON.stringify(data))\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.13",
		"@types/node": "^22",
		"@types/pako": "^2.0.4",
		"@types/qrcode": "^1.5.6",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.21.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7",
		"wrangler": "^4.84.1"
	},
	"dependencies": {
		"lucide-svelte": "^0.548.0",
		"minisearch": "^7.2.0",
		"pako": "^2.1.0",
		"qrcode": "^1.5.4",
		"svelte-i18n": "^4.0.1"
	}
}
