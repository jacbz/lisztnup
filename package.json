{
	"name": "lisztnup",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "pnpm sync:tracklist && vite build && pnpm minify-json",
		"sync:tracklist": "tsx scripts/sync-tracklist-md.ts",
		"score:sim": "tsx scoring/run.ts",
		"score:sim:quick": "tsx scoring/run.ts --profile quick",
		"score:sim:heavy": "tsx scoring/run.ts --profile heavy",
		"score:test": "tsx scoring/tests.ts",
		"score:check": "tsc --project tsconfig.scoring.json",
		"minify-json": "node -e \"const fs=require('fs');const data=JSON.parse(fs.readFileSync('.svelte-kit/cloudflare/lisztnup.json','utf8'));fs.writeFileSync('.svelte-kit/cloudflare/lisztnup.json',JSON.stringify(data))\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260508.1",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.59.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.6.0",
		"@types/pako": "^2.0.4",
		"@types/qrcode": "^1.5.6",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.7",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.10",
		"wrangler": "^4.87.0"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1",
		"minisearch": "^7.2.0",
		"pako": "^2.1.0",
		"qrcode": "^1.5.4",
		"svelte-i18n": "^4.0.1"
	}
}
